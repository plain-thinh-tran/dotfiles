#!/usr/bin/env -S python3 -I
import json
import os
import pty
import select
import subprocess
import sys
import time

if len(sys.argv) < 2:
    sys.exit("usage: drain-queue-yes <queueName> [messageIds...] [--stage <stage>]")

args = sys.argv[1:]
stage = "prod-uk"
if "--stage" in args:
    i = args.index("--stage")
    stage = args[i + 1]
    del args[i : i + 2]

queue, ids = args[0], args[1:]
if not ids:
    out = subprocess.run(
        ["plain-internal", "ops", "peek-queue", queue, "--stage", stage, "--ugly"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout
    ids = [m["id"] for m in json.loads(out)["messages"]]
    if not ids:
        print(f"{queue}: no visible messages")
        sys.exit(0)

argv = ["plain-internal", "ops", "drain-queue", "--stage", stage, "--queue-name", queue, *ids]
pid, fd = pty.fork()
if pid == 0:
    os.execvp(argv[0], argv)

buf = b""
answered = 0
deadline = time.time() + 600
while time.time() < deadline:
    r, _, _ = select.select([fd], [], [], 1)
    if not r:
        continue
    try:
        chunk = os.read(fd, 4096)
    except OSError:
        break
    if not chunk:
        break
    sys.stdout.write(chunk.decode(errors="replace"))
    sys.stdout.flush()
    buf += chunk
    if buf.count(b"Run it?") > answered:
        answered = buf.count(b"Run it?")
        time.sleep(0.5)
        os.write(fd, b"\x1b[B")
        time.sleep(0.3)
        os.write(fd, b"\r")

_, status = os.waitpid(pid, 0)
sys.exit(os.waitstatus_to_exitcode(status))
