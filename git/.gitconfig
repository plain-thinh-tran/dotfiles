[user]
	email = thinh.tran@plain.com
	name = Thinh

[safe]
	directory = /Users/thinhtran/workspace/services

[push]
	autoSetupRemote = true
	default = current

[pull]
	rebase = true

[merge]
	conflictStyle = zdiff3

[rerere]
	enabled = true
	autoUpdate = true

[url "git@github.com:"]
	insteadOf = https://github.com/

[alias]
	firefight = "!git log --oneline --all --since='1 year ago' --grep='revert\\|hotfix\\|rollback' -i"
	topchanges = "!git log --since='1 year ago' --name-only --pretty=format: | sort | uniq -c | sort -rn | head -20"
	bugcluster = "!git log --since='1 year ago' --name-only --pretty=format: --grep='fix\\|bug' -i | sort | uniq -c | sort -rn | head -20"
